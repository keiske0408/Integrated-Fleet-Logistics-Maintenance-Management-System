# Enable in-memory demo accounts and simulated role identity headers for local Vite development
VITE_ENABLE_DEV_AUTH_HEADERS=true

# API backend target (defaults to http://localhost:5000)
# VITE_API_PROXY_TARGET=http://localhost:5000

# Microsoft Entra ID (optional for local mock/demo development)
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_API_SCOPE=
