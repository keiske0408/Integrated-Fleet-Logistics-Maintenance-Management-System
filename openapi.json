        "summary": "Approve a Purchase Requisition (gated spend)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "PR approved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
