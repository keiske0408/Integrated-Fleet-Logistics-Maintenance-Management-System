        "responses": {
          "200": {
            "description": "Vehicles list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "plateNumber": {
                        "type": "string"
                      },
                      "currentKm": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "lastPmsKm": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "pmsIntervalKm": {
                        "type": "integer",
